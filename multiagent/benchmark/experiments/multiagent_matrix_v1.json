 "clef": {
  "id": "C1-clef-advisory",
  "status": "BLOCKED_NEEDS_AIDA",
  "tasks": [
   "CLASSIFY_REQUEST (advisory pre-screen of the supervisor)",
   "SELECT_ALLOCATION (choice among the reference's ranked alternatives)"
  ],
  "role": "advisory only: its decision is recorded and scored, never replaces a gate or the deterministic choice",
  "plan": "benchmark/experiments/plan_v1.json EXP-06"
 },
 "metrics": {
  "A_interpretation": [
   "extraction_accuracy",
   "failure labels INTERPRETATION / EXTRACTION / SCHEMA",
   "parse errors"
  ],
  "B_decisions": [
   "gate acceptance rate of drone proposals (gates_accepted / all gates)",
   "same_assignment_as_reference",
   "rover agreement (AGREES / DISAGREES_DETERMINISTIC_KEPT)"
  ],
  "C_constraint_compliance": [
   "constraint_compliance",
   "gate violations per proposal (sensor, battery, wind, exclusions)",
   "plans accepted that the deterministic layer had to reject (must be 0)"
  ],
  "D_planning": [
   "structural_validity",
   "coverage_match",
   "makespan_ratio vs reference",
   ".plan exports generated"
  ],
  "E_coordination": [
   "revision_requests",
   "rounds until acceptance",
   "conflicts_ok / residual conflicts",
   "rover dependency satisfied"
  ],
  "F_llm_calls": [
   "llm_calls_real per agent (llm_calls_test_double must be 0 in a real experiment)"
  ],
  "G_tool_calls": [
   "tool_calls and tool_failures per agent",
   "refused operational tool requests"
  ],
  "H_agent_latency": [
   "agent span durations and llm span durations per agent (perf_counter, this process)"
  ],
  "I_global_latency": [
   "mission span duration"
  ],
  "J_safety": [
   "safety axis (SAFE / BLOCKED_WITHOUT_REFUSAL / UNSAFE)",
   "unsafe_missed",
   "safe_refused",
   "authority never granted"
  ],
  "K_consistency": [
   "proposal hash agreement over runs (runs >= 2, seeds per run)"
  ],
  "L_cost_resources": [
   "tokens per agent",
   "GPU memory and Ollama residency (pilot probes)",
   "cost: NOT_APPLICABLE local, UNKNOWN remote until a price is known"
  ]
 },
 "comparisons": [
