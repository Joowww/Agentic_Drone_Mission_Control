ation. Never invent a target, coordinates or a\nposition. Request validate_ground_target for each proposed target and check_dependency for each wait point.\nTOOLS: [{\"arguments\": {\"additionalProperties\": false, \"properties\": {\"target_point\": {\"maxLength\": 40, \"minLength\": 1, \"title\": \"Target Point\", \"type\": \"string\"}}, \"required\": [\"target_point\"], \"title\": \"GroundTargetArgs\", \"type\": \"object\"}, \"description\": \"straight ground route from the rover's declared start to a declared POI (drivable area, exclusions)\", \"name\": \"validate_ground_target\"}, {\"arguments\": {\"additionalProperties\": false, \"properties\": {\"aerial_points\": {\"items\": {\"type\": \"string\"}, \"maxItems\": 20, \"title\": \"Aerial Points\", \"type\": \"array\"}, \"point\": {\"maxLength\": 40, \"minLength\": 1, \"title\": \"Point\", \"type\": \"string\"}}, \"required\": [\"point\"], \"title\": \"DependencyArgs\", \"type\": \"object\"}, \"description\": \"whether a drone task of the current proposal reaches a point the rover must wait for\", \"name\": \"check_dependency\"}]\nTASK (data): {\"aerial_points_proposed\": [\"POI_1\", \"POI_3\"], \"goal\": \"propose each ground task (declared target, wait point) or list what is missing\", \"ground_objectives\": [{\"after_aerial\": true, \"coordinates\": null, \"description\": \"target of observation fixture-drone_02-POI_3 (red_card, TEST_FIXTURE)\", \"objective_id\": \"G1\", \"point_id\": \"POI_3\"}], \"rover\": \"rover_01\"}\nCONTEXT (data): [{\"data\": {\"aerial_points_proposed\": [\"POI_1\", \"POI_3\"], \"available\": true, \"declared_pois\": [\"POI_1\", \"POI_2\", \"POI_3\", \"POI_4\", \"POI_5\"], \"localization\": {\"accredited_live_localization\": false, \"note\": \"a plan to a declared POI only; executing it needs a verified pose source\", \"source\": \"start point declared in the operating context (synthetic)\"}, \"rover\": \"rover_01\", \"start_point\": \"ROVER_START\", \"status\": \"OK\"}, \"notice\": \"