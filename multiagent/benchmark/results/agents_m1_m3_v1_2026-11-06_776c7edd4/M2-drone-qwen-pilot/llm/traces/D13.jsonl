n each objective to at most one capable drone; routes must pass validation and separation\", \"objectives\": [{\"objective_id\": \"A1\", \"point_id\": \"POI_3\", \"required_sensor\": \"thermal\"}, {\"objective_id\": \"A2\", \"point_id\": \"POI_9\", \"required_sensor\": \"multispectral\"}], \"wind_speed_kmh\": 0.0}\nCONTEXT (data): [{\"data\": {\"drones\": [{\"available\": true, \"battery_percent\": 100.0, \"max_wind_kmh\": 30.0, \"sensors\": [\"rgb\"], \"takeoff_point\": \"TAKEOFF_1\", \"vehicle_id\": \"drone_01\"}, {\"available\": true, \"battery_percent\": 60.0, \"max_wind_kmh\": 20.0, \"sensors\": [\"multispectral\"], \"takeoff_point\": \"TAKEOFF_2\", \"vehicle_id\": \"drone_02\"}, {\"available\": true, \"battery_percent\": 21.5, \"max_wind_kmh\": 25.0, \"sensors\": [\"rgb\", \"thermal\"], \"takeoff_point\": \"TAKEOFF_3\", \"vehicle_id\": \"drone_03\"}], \"objectives\": [{\"eligible_drones\": [\"drone_03\"], \"objective_id\": \"A1\", \"point_id\": \"POI_3\", \"required_sensor\": \"thermal\"}, {\"eligible_drones\": [\"drone_02\"], \"objective_id\": \"A2\", \"point_id\": \"POI_9\", \"required_sensor\": \"multispectral\"}], \"site_points\": {\"POI_1\": [-30.0, 5.0], \"POI_2\": [-15.0, 10.0], \"POI_3\": [0.0, 5.0], \"POI_4\": [15.0, 10.0], \"POI_5\": [30.0, 5.0], \"POI_6\": [45.0, 10.0], \"POI_7\": [-10.0, 35.0], \"POI_8\": [50.0, 35.0], \"POI_9\": [3.0, 5.0], \"TAKEOFF_1\": [-30.0, -15.0], \"TAKEOFF_2\": [-15.0, -1...[4284 chars]"}, "provider": "ollama", "raw_sha256": "df73c54636cc18a46aaf2d2d33ec28272b769e311e203e3345e348c60fcef547", "raw_text": "{\n  \"proposal\": {\n    \"assignments\": {\n      \"drone_01\": [],\n      \"drone_02\": [\"A2\"],\n      \"drone_03\": [\"A1\"]\n    }\n  },\n  \"verify\": [\n    {\n      \"tool\": \"validate_route\",\n      \"arguments\": {\n        \"vehicle_id\": \"drone_02\",\n        \"sequence\": [\"A2\"]\n      }\n    },\n    {\n      \"tool\": \"validate_route\",\n      \"arguments\": {\n        \"vehicle_id\": \"drone_03\",\n 