{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tfg.rover.mission-execution/1",
  "title": "TFG Rover mission proposal",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "mission", "rover", "goal", "localization", "dependencies", "constraints", "provenance", "authorization", "validity", "executor", "stop_conditions"],
  "properties": {
    "schema": {"const": "tfg.rover.mission-execution/1"},
    "mission": {"type": "object", "required": ["id", "sha256"], "properties": {"id": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}, "additionalProperties": false},
    "rover": {"type": "object", "required": ["vehicle_id", "platform"], "properties": {"vehicle_id": {"type": "string", "minLength": 1}, "platform": {"type": "string", "minLength": 1}}, "additionalProperties": false},
    "goal": {"type": "object", "required": ["frame", "x_m", "y_m", "conditional"], "properties": {"frame": {"type": "string", "minLength": 1}, "x_m": {"type": "number"}, "y_m": {"type": "number"}, "conditional": {"type": "boolean"}}, "additionalProperties": false},
    "localization": {"type": "object", "required": ["frame", "x_m", "y_m", "source", "source_sha256", "validated"], "properties": {"frame": {"type": "string"}, "x_m": {"type": "number"}, "y_m": {"type": "number"}, "source": {"type": "string"}, "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "validated": {"const": true}, "observed_monotonic_s": {"type": "number"}}, "additionalProperties": false},
    "dependencies": {"type": "array", "items": {"type": "string"}},
    "constraints": {"type": "object", "minProperties": 1},
    "provenance": {"type": "object", "required": ["source", "source_sha256"], "properties": {"source": {"type": "string"}, "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}, "additionalProperties": false},
    "authorization": {"type": "object", "required": ["scope_sha256", "human_authorized"], "properties": {"scope_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "human_authorized": {"type": "boolean"}}, "additionalProperties": false},
    "validity": {"type": "object", "required": ["not_before_utc", "expires_at_utc"], "properties": {"not_before_utc": {"type": "string", "format": "date-time"}, "expires_at_utc": {"type": "string", "format": "date-time"}}, "additionalProperties": false},
    "executor": {"type": "object", "required": ["id", "version"], "properties": {"id": {"type": "string"}, "version": {"type": "string"}}, "additionalProperties": false},
    "stop_conditions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}
