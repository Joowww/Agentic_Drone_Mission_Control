{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tfg.rover.passive-session-scope/1",
  "title": "One passive rover_only lifecycle session scope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "scope_id", "session_id", "session_type", "profile", "vehicle", "operator_id", "authorization_basis", "host", "environment_execution", "protected_resources", "precheck", "allowed_operations", "prohibited_operations", "max_session_duration_s", "issued_at_utc", "expires_at_utc", "single_use", "initial_state_requirements", "motion_binding_protocol", "worker", "close_requirements", "abort_conditions", "evidence_integrity"],
  "properties": {
    "schema": {"const": "tfg.rover.passive-session-scope/1"},
    "scope_id": {"type": "string", "format": "uuid"},
    "session_id": {"type": "string", "format": "uuid"},
    "session_type": {"const": "PASSIVE_ROVER_VALIDATION"},
    "profile": {"const": "rover_only"},
    "vehicle": {"type": "object", "additionalProperties": false, "required": ["vehicle_id", "interface", "platform"], "properties": {"vehicle_id": {"const": "rover_01"}, "interface": {"const": "v3"}, "platform": {"const": "ArduRover SITL"}}},
    "operator_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "authorization_basis": {"const": "OPERATOR_DECLARED_NOT_AUTHENTICATED"},
    "host": {"type": "object", "additionalProperties": false, "required": ["boot_id"], "properties": {"boot_id": {"type": "string", "minLength": 1}}},
    "environment_execution": {"type": "object", "required": ["persistent_identity", "container_started_at", "container_boot_id"]},
    "protected_resources": {"type": "array", "minItems": 4, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "precheck": {"type": "object", "additionalProperties": false, "required": ["status", "observed_at_utc", "report_sha256", "audit_state", "conditions"], "properties": {"status": {"const": "SATISFIED"}, "observed_at_utc": {"type": "string", "format": "date-time"}, "report_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "audit_state": {"type": ["string", "null"]}, "conditions": {"type": "array", "minItems": 16, "uniqueItems": true, "items": {"type": "string"}}}},
    "allowed_operations": {"type": "array", "minItems": 7, "uniqueItems": true, "items": {"enum": ["START_ROVER_ONLY", "MOTION_BINDING_V2", "READ_PARAMETERS", "PASSIVE_OBSERVE_100", "CLOSE_WORKER", "STOP_SAME_SESSION", "FINAL_INVENTORY"]}},
    "prohibited_operations": {"type": "array", "minItems": 11, "uniqueItems": true, "items": {"enum": ["ARM", "DISARM", "GUIDED", "HOLD", "CMD_VEL", "SEND_TARGET", "MISSION_UPLOAD", "MOVE", "WRITE_PARAMETER", "ACTIVATE_POLICY", "PHYSICAL_HARDWARE_CONTROL"]}},
    "max_session_duration_s": {"const": 300.0},
    "issued_at_utc": {"type": "string", "format": "date-time"},
    "expires_at_utc": {"type": "string", "format": "date-time"},
    "single_use": {"const": true},
    "initial_state_requirements": {"type": "object", "additionalProperties": false, "properties": {"armed": {"const": false}, "driving": {"const": false}}, "required": ["armed", "driving"]},
    "motion_binding_protocol": {"const": "/2"},
    "worker": {"type": "object", "additionalProperties": false, "properties": {"mode": {"const": "PASSIVE"}, "observations": {"const": 100}, "parameter_capture": {"const": "READ_ONLY"}, "stationarity_report": {"const": true}}, "required": ["mode", "observations", "parameter_capture", "stationarity_report"]},
    "close_requirements": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"enum": ["WORKER_CLOSED", "STOP_SAME_SESSION", "FINAL_INVENTORY"]}},
    "abort_conditions": {"type": "array", "minItems": 6, "uniqueItems": true, "items": {"type": "string"}},
    "evidence_integrity": {"type": "object", "additionalProperties": false, "properties": {"canonical_json": {"const": true}, "sha256": {"const": true}, "append_only_consumption": {"const": true}}, "required": ["canonical_json", "sha256", "append_only_consumption"]}
  }
}
