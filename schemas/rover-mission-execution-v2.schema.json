{
  "title": "Plan-bound TFG Rover proposal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "mission",
    "plan_id",
    "rover",
    "goal",
    "localization",
    "dependencies",
    "constraints",
    "operator_limits",
    "provenance",
    "authorization",
    "validity",
    "executor",
    "stop_conditions",
    "plan_sha256"
  ],
  "properties": {
    "schema": {
      "const": "tfg.rover.mission-execution/2"
    },
    "mission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "plan_id": {
      "type": "string",
      "minLength": 1
    },
    "rover": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vehicle_id",
        "platform"
      ],
      "properties": {
        "vehicle_id": {
          "type": "string",
          "minLength": 1
        },
        "platform": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "goal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "objective",
        "frame",
        "x_m",
        "y_m",
        "conditional"
      ],
      "properties": {
        "objective": {
          "type": "string",
          "minLength": 1
        },
        "frame": {
          "type": "string",
          "minLength": 1
        },
        "x_m": {
          "type": "number"
        },
        "y_m": {
          "type": "number"
        },
        "conditional": {
          "type": "boolean"
        }
      }
    },
    "localization": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/localization"
        }
      ]
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "constraints": {
      "type": "object",
      "minProperties": 1
    },
    "operator_limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_speed_mps",
        "timeout_s",
        "max_distance_m",
        "localization_max_uncertainty_m",
        "localization_max_age_s"
      ],
      "properties": {
        "max_speed_mps": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "timeout_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "max_distance_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "localization_max_uncertainty_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "localization_max_age_s": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "source_sha256"
      ],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "source_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "authorization": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/authorization"
        }
      ]
    },
    "validity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "not_before_utc",
        "expires_at_utc"
      ],
      "properties": {
        "not_before_utc": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at_utc": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "executor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "stop_conditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "plan_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "localization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frame",
        "x_m",
        "y_m",
        "uncertainty_m",
        "source",
        "source_sha256",
        "validated",
        "observed_at_utc",
        "transform"
      ],
      "properties": {
        "frame": {
          "type": "string",
          "minLength": 1
        },
        "x_m": {
          "type": "number"
        },
        "y_m": {
          "type": "number"
        },
        "uncertainty_m": {
          "type": "number",
          "minimum": 0
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "source_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "validated": {
          "type": "boolean"
        },
        "observed_at_utc": {
          "type": "string",
          "format": "date-time"
        },
        "transform": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/transform"
            }
          ]
        }
      }
    },
    "transform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_frame",
        "target_frame",
        "matrix",
        "uncertainty_m",
        "uncertainty_rad",
        "source",
        "source_sha256",
        "validated",
        "not_before_utc",
        "expires_at_utc"
      ],
      "properties": {
        "source_frame": {
          "type": "string",
          "minLength": 1
        },
        "target_frame": {
          "type": "string",
          "minLength": 1
        },
        "matrix": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number"
            }
          }
        },
        "uncertainty_m": {
          "type": "number",
          "minimum": 0
        },
        "uncertainty_rad": {
          "type": "number",
          "minimum": 0
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "source_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "validated": {
          "type": "boolean"
        },
        "not_before_utc": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at_utc": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope_sha256",
        "human_authorized",
        "operator_id",
        "operator_status",
        "revocation_status",
        "authorization_receipt_sha256"
      ],
      "properties": {
        "scope_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "bridge_scope_sha256": {
          "$ref": "#/$defs/sha256",
          "description": "Optional originating bridge request scope, retained when an adapter binds a human receipt to both bridge and Codex plans."
        },
        "human_authorized": {
          "type": "boolean"
        },
        "operator_id": {
          "type": "string",
          "minLength": 1
        },
        "operator_status": {
          "enum": [
            "DECLARED",
            "AUTHENTICATED",
            "UNKNOWN"
          ]
        },
        "revocation_status": {
          "enum": [
            "ACTIVE",
            "REVOKED",
            "UNKNOWN"
          ]
        },
        "authorization_receipt_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
